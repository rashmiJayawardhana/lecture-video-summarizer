# ============================================================
# INTEGRA — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ─── Project Settings ─────────────────────────────────────
PROJECT_NAME=lecture-video-summarizer
VERSION=0.1.0

# ─── Paths ─────────────────────────────────────────────────
DATA_DIR=./data
MODELS_DIR=./models
OUTPUTS_DIR=./outputs

# ─── GPU Settings ──────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./models/pretrained

# ─── API Keys ──────────────────────────────────────────────
# Module 1: AI-assisted annotation scoring (pick ONE)
#   Priority: Claude > GPT-4o > Gemini (free)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=<your primary key>     # FREE: https://aistudio.google.com/apikey
# GEMINI_API_KEY_FALLBACK=<your backup key>,<another backup key if you have one>
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
#   Both use "-latest" aliases on purpose — Google frequently retires dated
#   model names (gemini-2.0-flash, gemini-2.0-flash-lite, gemini-2.5-flash-lite
#   have all stopped working since). If one ever breaks, check `client.models.list()`.

# Module 4: GPT-4o for narration script generation
# OPENAI_API_KEY=your_openai_api_key_here

# Module 4: Ollama Cloud for the content/data-loss check step (hosted, not local —
# deployment laptop has no GPU/spec to run models locally)
#   Sign up (no card needed): https://ollama.com  ->  Settings > API Keys
#   Free-tier model catalog: https://ollama.com/search?c=cloud (changes over time —
#   confirm OLLAMA_CLOUD_MODEL below is still listed there before running)
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_MODEL=gpt-oss:20b-cloud

# Optional: Hugging Face (for gated models)
# HUGGINGFACE_TOKEN=your_hf_token_here

# ─── Database (Supabase — job/pipeline status tracking) ───
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key_here
SUPABASE_JOBS_TABLE=jobs

# ─── Module 1 Settings ────────────────────────────────────
MODULE1_SEGMENT_DURATION=10
MODULE1_SEQUENCE_LENGTH=10
MODULE1_IMPORTANCE_THRESHOLD=0.5

# ─── Module 2 Settings ────────────────────────────────────
MODULE2_WHISPER_MODEL=large-v3
MODULE2_MAX_TRANSCRIPT_LENGTH=1024

# ─── Module 3 Settings ────────────────────────────────────
# Note: not currently read by any code, and out of date - the real OCR step
# (src/module3_visual/ocr.py) uses EasyOCR, not TrOCR. Kept for reference only.
MODULE3_SLIDE_SIMILARITY_THRESHOLD=0.95
MODULE3_OCR_MODEL=microsoft/trocr-base-printed

# ─── Module 4 Settings ────────────────────────────────────
MODULE4_GPT_MODEL=gpt-4o
MODULE4_TTS_VOICE=en-US-AriaNeural
MODULE4_TRANSITION_DURATION=0.5
MODULE4_VIDEO_CODEC=libx264
MODULE4_MAX_NARRATION_TOKENS=100

# ─── Pipeline Settings ────────────────────────────────────
MAX_VIDEO_LENGTH=3600          # 60 minutes input
TARGET_SUMMARY_LENGTH=600      # 10 minutes output
VIDEO_FPS=24
VIDEO_RESOLUTION=720
MIN_SCORE_THRESHOLD=0.3

# ─── Fusion Weights (tuned in Week 7) ─────────────────────
FUSION_W1_VISUAL=0.33
FUSION_W2_TEXT=0.33
FUSION_W3_SLIDE=0.34

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
