# Environment Variables Template
# Copy this file to .env and fill in your values

# Project Settings
PROJECT_NAME=lecture-video-summarizer
VERSION=0.1.0

# Paths
DATA_DIR=./data
MODELS_DIR=./models
OUTPUTS_DIR=./outputs

# GPU Settings
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./models/pretrained

# Training Settings
BATCH_SIZE=8
NUM_WORKERS=4
LEARNING_RATE=0.001
NUM_EPOCHS=50

# Logging
LOG_LEVEL=INFO
WANDB_PROJECT=lecture-video-summarization
WANDB_ENTITY=your-team-name

# API Keys (if needed)
# WANDB_API_KEY=your_wandb_api_key_here
# HUGGINGFACE_TOKEN=your_hf_token_here

# Video Processing
MAX_VIDEO_LENGTH=3600  # seconds (60 minutes)
TARGET_SUMMARY_LENGTH=600  # seconds (10 minutes)
VIDEO_FPS=24
VIDEO_RESOLUTION=720

# Module 1 Settings
MODULE1_SEGMENT_DURATION=10  # seconds
MODULE1_IMPORTANCE_THRESHOLD=0.5

# Module 2 Settings
MODULE2_WHISPER_MODEL=base
MODULE2_MAX_TRANSCRIPT_LENGTH=1024

# Module 3 Settings
MODULE3_SLIDE_SIMILARITY_THRESHOLD=0.95
MODULE3_OCR_LANGUAGE=eng

# Module 4 Settings
MODULE4_TRANSITION_DURATION=0.5  # seconds
MODULE4_VIDEO_CODEC=libx264
